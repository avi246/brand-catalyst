# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Database: Tiger Data (managed Postgres + TimescaleDB) ---
# Tiger Cloud console -> your service -> Connect -> connection string
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require"

# --- Auth: Clerk ---
# dashboard.clerk.com -> your app -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- Later milestones ---
# Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=""
# Pusher Channels (dashboard.pusher.com -> App keys)
PUSHER_APP_ID=""
NEXT_PUBLIC_PUSHER_KEY=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_CLUSTER=""
# YouTube Data API v3 (Google Cloud console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=""
